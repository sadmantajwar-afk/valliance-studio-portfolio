# Valliance Studio - Environment Configuration

# 1. Meta (Facebook) Pixel ID
# Paste your 15-16 digit Meta Pixel ID here (from Meta Events Manager)
# Example: VITE_META_PIXEL_ID=123456789012345
VITE_META_PIXEL_ID=

# 2. Contact Form & Lead Webhook Endpoint (Optional)
# Defaults to FormSubmit (forwarding to hello@valliancestudio.com)
# You can override with Formspree, Make.com, Zapier, or a custom Cloudflare Worker webhook
# Example: VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/xyz
VITE_CONTACT_FORM_ENDPOINT=
